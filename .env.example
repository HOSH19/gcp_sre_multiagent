# Shared
GCP_PROJECT_ID=your-gcp-project
GCP_REGION=us-central1
MODE=local

# Patient
PATIENT_PORT=8081
APP_SECRET=local-secret
CHAOS_ADMIN_TOKEN=dev-chaos-token
REQUIRED_CONFIG_KEY=APP_SECRET

# Chaos controller
CHAOS_PORT=8082
PATIENT_SERVICE_URL=http://127.0.0.1:8081
PATIENT_SERVICE_NAME=patient
GOOD_REVISION=
BAD_REVISION=

# API / orchestrator
API_PORT=8080
WEB_ORIGIN=http://127.0.0.1:3000
VERTEX_LOCATION=us-central1
GEMINI_FLASH_LITE_MODEL=gemini-2.5-flash-lite
GEMINI_FLASH_MODEL=gemini-2.5-flash
# Open ReAct (Vertex function calling). Default: on when MODE=gcp, off when MODE=local.
# Set REACT=off for deterministic CI/eval; REACT=on to force ReAct even in local.
REACT=
STORE_BACKEND=
FIRESTORE_EMULATOR_HOST=
BIGQUERY_DATASET=sre_agents
BQ_FAIL_CLOSED=true
GCS_BUCKET=
ARTIFACTS_BUCKET=
PATIENT_HEALTH_URL=http://127.0.0.1:8081/health
# Optional: Cloud Monitoring uptime check id (short or projects/.../uptimeCheckConfigs/...).
# When unset in MODE=gcp, discover by host matching PATIENT_SERVICE_URL / PATIENT_HEALTH_URL.
UPTIME_CHECK_ID=
# Optional: JSON service registry (array or { "services": [...] }). Overrides Firestore config/serviceRegistry.
# Fields: projectId, region, name, owner, uptimeCheckId, chaosLab, pagerPolicy, playbookHints
# SERVICE_REGISTRY_JSON=[{"projectId":"your-gcp-project","region":"us-central1","name":"patient","chaosLab":true,"owner":"chaos-lab","pagerPolicy":{"severity":"warning"}}]
SERVICE_REGISTRY_JSON=
CHAOS_CONTROLLER_URL=http://127.0.0.1:8082
# Concurrent investigation leases (Firestore in MODE=gcp; in-process for local).
MAX_CONCURRENT_RUNS=1
MAX_CONCURRENT_PER_SERVICE=1
LEASE_TTL_MS=900000
# Paging (PagerDuty Events API v2). Default: off in MODE=local;
# on in MODE=gcp when routing key is set. Force with PAGING=on|off.
PAGING=
PAGERDUTY_ROUTING_KEY=

# Web
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080
